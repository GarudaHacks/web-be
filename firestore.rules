rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow admins to read and write all documents
    match /{document=**} {
      allow read, write: if hasAnyRole(["ADMIN", "OWNER"]);
    }

    // Rowy: Allow signed in users to read Rowy configuration and admins to write
    match /_rowy_/{docId} {
      allow read: if request.auth.token.roles.size() > 0;
      allow write: if hasAnyRole(["ADMIN", "OWNER"]);
    	match /{document=**} {
        allow read: if request.auth.token.roles.size() > 0;
        allow write: if hasAnyRole(["ADMIN", "OWNER"]);
      }
      match /schema/{tableId} {
        allow update: if canModify(tableId,'pc')
        match /{document=**} {allow read,write: if canModify(tableId,'pc')}
      }
       match /groupSchema/{tableId} {
        allow update: if canModify(tableId,'cg')
        match /{document=**} {allow read,write: if canModify(tableId,'cg')}
      }
    	function canModify(tableId,tableType) {
      	return hasAnyRole(get(/databases/$(database)/documents/_rowy_/settings)
        .data.tablesSettings[tableType][tableId].modifiableBy)
	   	}
    }
    // Rowy: Allow users to edit their settings
    match /_rowy_/userManagement/users/{userId} {
      allow get, update, delete: if isDocOwner(userId);
      allow create: if request.auth.token.roles.size() > 0;
    }
    // Rowy: Allow public to read public Rowy configuration
    match /_rowy_/publicSettings {
      allow get: if true;
    }

    // Rowy: Utility functions
    function isDocOwner(docId) {
      return request.auth != null && (request.auth.uid == resource.id || request.auth.uid == docId);
    }
    function hasAnyRole(roles) {
      return request.auth != null && request.auth.token.roles.hasAny(roles);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isGarudaAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.matches('.*@garudahacks[.]com$');
    }

    function isTeamMember(teamId) {
      let teamDoc = get(/databases/$(database)/documents/teams/$(teamId));
      return request.auth != null &&
             teamDoc != null &&
             'members' in teamDoc.data &&
             teamDoc.data.members is list &&
             request.auth.uid in teamDoc.data.members;
    }

  	function verifyTeamMembership(requestingUid, resourceOwnerUid, teamId) {
      let teamDoc = get(/databases/$(database)/documents/teams/$(teamId));
      return teamDoc != null &&
             'members' in teamDoc.data &&
             teamDoc.data.members is list &&
             requestingUid in teamDoc.data.members &&
             resourceOwnerUid in teamDoc.data.members;
    }

    function haveSharedTeam(requestingUid, resourceOwnerUid) {
      let requestingUserDoc = get(/databases/$(database)/documents/users/$(requestingUid));
      let resourceOwnerUserDoc = get(/databases/$(database)/documents/users/$(resourceOwnerUid));

      return requestingUserDoc != null && resourceOwnerUserDoc != null &&
             'team' in requestingUserDoc.data && 'team' in resourceOwnerUserDoc.data &&
             requestingUserDoc.data.team is string &&
             requestingUserDoc.data.team == resourceOwnerUserDoc.data.team &&
             verifyTeamMembership(requestingUid, resourceOwnerUid, requestingUserDoc.data.team);
    }

    // Fields on /users that decide privileges or lifecycle state.
    // Only the backend (Admin SDK) or Garuda admins may set them:
    // application status / RSVP is set via POST /application/rsvp after the
    // deadline + acceptance checks, roles via auth flows, teams via matching.
    function touchesPrivilegedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['role', 'status', 'admin', 'team', 'email', 'discord_uid', 'confirmedRsvpAt']
      );
    }

    match /applications/{applicationId} {
      // Applicants may read their own application. All writes (submission,
      // status changes, RSVP) go through the backend API which enforces
      // deadlines and state transitions — never through the client SDK.
      allow read: if isGarudaAdmin() ||
      	(isSignedIn() && request.auth.uid == applicationId);
      allow write: if isGarudaAdmin();
    }

    match /users/{userId} {
      allow read: if isGarudaAdmin() ||
        (isSignedIn() && request.auth.uid == userId) ||
        (isSignedIn() && haveSharedTeam(request.auth.uid, userId));

      // Portal creates a bare profile document at first sign-in.
      // Nothing privileged: status may only start as "not applicable".
      allow create: if isGarudaAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
        request.resource.data.email == request.auth.token.email &&
        (!('status' in request.resource.data) || request.resource.data.status == 'not applicable')
      );

      // Owners may edit profile fields, but never role/status/team/etc.
      allow update: if isGarudaAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !touchesPrivilegedUserFields()
      );

      // Account deletion goes through the backend (DELETE /user/me).
      allow delete: if isGarudaAdmin();
    }

    match /attendances/{attendanceId} {
    	allow read: if isGarudaAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid) ||
        (isSignedIn() && haveSharedTeam(request.auth.uid, resource.data.uid));
    }

    match /announcements/{announcementId} {
    	allow read: if true;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
        && request.resource.data.seen.hasAll(resource.data.seen)
        && request.resource.data.seen.size() == resource.data.seen.size() + 1
        && request.resource.data.seen.hasAll([request.auth.uid]);
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();

      // Creator must be the team leader and a member of the new team.
      allow create: if isGarudaAdmin() || (
        isSignedIn() &&
        request.resource.data.leader == request.auth.uid &&
        request.resource.data.members is list &&
        request.auth.uid in request.resource.data.members
      );

      // Members may edit their own team (only the leader may reassign
      // leadership); non-members may only append themselves to `members`.
      allow update: if isGarudaAdmin() || (
        isSignedIn() && (
          (
            resource.data.members is list &&
            request.auth.uid in resource.data.members &&
            (request.resource.data.leader == resource.data.leader ||
              request.auth.uid == resource.data.leader)
          ) || isJoiningTeam()
        )
      );

      allow delete: if isGarudaAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.leader);

      // Join: the only change is `members` gaining exactly the requester.
      function isJoiningTeam() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members);
      }
    }

    match /config/{configId} {
    	allow read: if true;
    }

    match /user_mobile/{userId} {
    	allow read, write: if isSignedIn() && (request.auth.uid == userId || isGarudaAdmin());
    }

    match /schedules/{scheduleId} {
    	allow read: if true;
    }

    match /hack_cards/{userId} {
  		allow read: if isSignedIn() &&
    			(request.auth.uid == userId || haveSharedTeam(request.auth.uid, userId));
  		allow write: if isSignedIn() && request.auth.uid == userId;
		}

  	match /team_cards/{teamId} {
  		allow read: if isSignedIn();
      // Only members of the corresponding team may write its card.
      allow write: if isGarudaAdmin() || isTeamMember(teamId);
		}

		match /checkin_schedules/{docId} {
  		allow read: if isSignedIn();
		}

    match /{document=**} {
      allow read, write: if isGarudaAdmin();
    }

  }
}
